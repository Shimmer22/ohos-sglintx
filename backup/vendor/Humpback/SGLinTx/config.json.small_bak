{
  "product_name": "SGLinTx",
  "version": "3.0",
  "type": "small",
  "ohos_version": "OpenHarmony 3.2",
  "device_company": "Humpback",
  "board": "SGLinTx",
  "target_cpu": "riscv64",
  "target_os": "linux",
  "kernel_type": "linux",
  "kernel_version": "5.10",
  "subsystems": [
    {
      "subsystem": "startup",
      "components": [
        { "component_name": "init", "features": ["enable_ohos_startup_init_lite_use_thirdparty_mbedtls = false"] }
      ]
    },
    {
      "subsystem": "hiviewdfx",
      "components": [
        { "component_name": "hilog_lite", "features": [] }
      ]
    }
  ]
}
