# SG2002 Nano Kernel Configuration Patch for OpenHarmony
# Apply this patch to LicheeRV-Nano-Build default config

# Enable Android Binder (Required for OpenHarmony IPC)
CONFIG_ANDROID_BINDER_IPC=y
# CONFIG_ANDROID_BINDERFS is not set
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Enable BPF (Recommended for OH)
CONFIG_BPF_SYSCALL=y

# Enable additional filesystem support
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_ZSTD=y

# Enable debugfs for OH development
CONFIG_DEBUG_FS=y

# Enable cgroups (recommended)
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y

# Enable namespaces
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# Enable seccomp
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Enable security options
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y
